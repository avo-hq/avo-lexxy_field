<%= field_wrapper(**field_wrapper_args, full_width: true) do %>
  <%= content_tag :div,
    class: "relative block w-full",
    data: {controller: ("lexxy-field" if media_library?), unique_selector: unique_id}.compact do %>
    <%= editor_tag %>
    <% if media_library? %>
      <%# Lexxy builds its toolbar client side, so there is no slot to render
          into — the controller moves this button in once the editor boots. %>
      <%= link_to media_library_path,
        class: "lexxy-editor__toolbar-button lexxy-field__media-library-button",
        title: t("avo.media_library.title"),
        hidden: true,
        data: {lexxy_field_target: "mediaLibraryButton", turbo_frame: ::Avo::MODAL_FRAME_ID} do %>
        <%= helpers.svg "tabler/outline/photo-alt" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
